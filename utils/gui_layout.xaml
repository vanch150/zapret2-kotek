                                <Button x:Name="BtnTgToggle" Content="Выключить" Style="{StaticResource SecondaryBtn}" MinWidth="96" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Включить или остановить фоновую службу Telegram Proxy"/>
