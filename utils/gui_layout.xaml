                    <!-- AI Bypass Card (SmartDNS via Windows NRPT) -->
                    <Border Style="{StaticResource GroupPanel}" Padding="16,14" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
