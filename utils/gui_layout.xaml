                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnAiServices" Content="Сервисы ▾" Style="{StaticResource SecondaryBtn}" Padding="11,7" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Выбрать конкретные ИИ-сервисы и свои домены"/>
                                    <ComboBox x:Name="CmbAiMode" Style="{StaticResource DarkCombo}" Width="142" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Авто — сам проверяет пул SmartDNS и выбирает живой узел для ИИ-сервисов"/>
                                    <Button x:Name="BtnAiToggle" Content="Включить" Style="{StaticResource SecondaryBtn}" MinWidth="96" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnAiProbe" Content="Проверить" Style="{StaticResource SecondaryBtn}" MinWidth="106" VerticalAlignment="Center" ToolTip="Проверить доступность выбранных ИИ-сервисов и при сбое переключиться на запасной узел"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="PnlAiServices" Visibility="Collapsed" Background="#14161B" BorderBrush="#262A33" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,10,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,-8">
                                            <CheckBox x:Name="ChkAi_gemini" Content="Google Gemini" Style="{StaticResource DarkCheckBox}" Margin="0,0,18,8"/>
                                            <CheckBox x:Name="ChkAi_chatgpt" Content="ChatGPT / OpenAI" Style="{StaticResource DarkCheckBox}" Margin="0,0,18,8"/>
                                            <CheckBox x:Name="ChkAi_copilot" Content="Copilot" Style="{StaticResource DarkCheckBox}" Margin="0,0,18,8"/>
                                            <CheckBox x:Name="ChkAi_grok" Content="Grok (xAI)" Style="{StaticResource DarkCheckBox}" Margin="0,0,18,8"/>
                                            <CheckBox x:Name="ChkAi_perplexity" Content="Perplexity" Style="{StaticResource DarkCheckBox}" Margin="0,0,18,8"/>
                                            <CheckBox x:Name="ChkAi_ide_ai" Content="Cursor / Windsurf" Style="{StaticResource DarkCheckBox}" Margin="0,0,18,8"/>
                                        </WrapPanel>
                                        <Button x:Name="BtnAiSelAll" Grid.Column="1" Content="Все" Style="{StaticResource SecondaryBtn}" Padding="12,6" FontSize="13" VerticalAlignment="Center" ToolTip="Выбрать или снять все базовые ИИ-сервисы (Claude и Google Antigravity включаются только вручную)"/>
                                    </Grid>
                                    <Border Height="1" Background="#262A33" Margin="0,10,0,9"/>
                                    <TextBlock Text="Вручную (есть нюансы)" FontSize="12" FontWeight="SemiBold" Foreground="#737A86" Margin="0,0,0,7"/>
                                    <WrapPanel VerticalAlignment="Center" Margin="0,0,0,-4">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,4">
                                            <CheckBox x:Name="ChkAi_claude" Content="Claude" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"/>
                                            <Border Background="#2A2316" BorderBrush="#5E4922" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="риск бана IP" FontSize="11.5" FontWeight="SemiBold" Foreground="#D9B066"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                            <CheckBox x:Name="ChkAi_antigravity" Content="Google Antigravity" Style="{StaticResource DarkCheckBox}" VerticalAlignment="Center"/>
                                            <Border Background="#1D222B" BorderBrush="#2E3542" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="нужен модуль для РФ" FontSize="11.5" FontWeight="SemiBold" Foreground="#9CA3AF"/>
                                            </Border>
                                        </StackPanel>
                                    </WrapPanel>
                                    <Border x:Name="BdAiClaudeWarn" Visibility="Collapsed" Background="#1F1A11" BorderBrush="#5E4922" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,9,0,0">
                                        <TextBlock Text="Осторожно: Anthropic может банить аккаунты за общие SmartDNS-IP и смену страны — для платного Claude безопаснее личный VPN/VPS со статичным IP." Foreground="#D9B066" FontSize="12.5" TextWrapping="Wrap"/>
                                    </Border>
                                    <Border x:Name="BdAiAntigravityHint" Visibility="Collapsed" Background="#1A1D24" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Сеть Antigravity пойдёт через SmartDNS. Для российского Google-аккаунта открой пошаговую настройку модуля." Foreground="#CBD5E1" FontSize="12.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                            <Button x:Name="BtnAiAntigravityHelper" Grid.Column="1" Content="Пошаговая настройка →" Style="{StaticResource SecondaryBtn}" Padding="10,5" FontSize="12.5" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Открыть пошаговый мастер настройки Google Antigravity"/>
                                        </Grid>
                                    </Border>
                                    <Border Height="1" Background="#262A33" Margin="0,10,0,9"/>
                                    <CheckBox x:Name="ChkAiVpnAutoPause" Content="Автопауза при full-tunnel VPN" Style="{StaticResource DarkCheckBox}" FontSize="13" Foreground="#CBD5E1" ToolTip="Ставить «Обход ИИ» на паузу только при включении full-tunnel VPN или системного прокси и возвращать после отключения (split-tunnel VPN не затрагивается)"/>
                                    <TextBlock x:Name="TxtAiPendingHint" Text="Набор сервисов изменён — нажми «Перезапустить», чтобы применить." Foreground="#D9B066" FontSize="12.5" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Полезные инструменты" FontSize="14" FontWeight="SemiBold" Foreground="#737A86" Margin="2,4,0,8"/>

                    <Border Style="{StaticResource GroupPanel}">
                        <StackPanel>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Фикс браузера (отключить QUIC)" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5" VerticalAlignment="Center"/><Border x:Name="BdBrowserFixBadge" Background="#23262E" BorderBrush="#343844" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="TxtBrowserFixBadge" Text="Выключен" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF"/></Border></StackPanel>
                                    <TextBlock x:Name="TxtBrowserFixState" Text="Включай, если тормозит YouTube или не грузятся смайлы 7TV (переводит браузеры на стабильный TCP 443)" FontSize="13.5" Foreground="#9CA3AF" Margin="0,3,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnBrowserFix" Content="Браузеры…" Style="{StaticResource SecondaryBtn}" Padding="11,6" FontSize="13" Margin="0,0,10,0" ToolTip="Выбрать конкретные браузеры (Chrome, Edge, Firefox, Яндекс, Brave, Vivaldi)"/>
                                    <CheckBox x:Name="ChkBrowserQuic" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" ToolTip="Отключает QUIC (HTTP/3) в установленных браузерах. Полностью совместимо с обходом ИИ."/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="Голос в Discord и онлайн-игры" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5" VerticalAlignment="Center"/></StackPanel>
                                        <TextBlock Text="Нужно только если в голосовом канале Discord висит «Подключение» или рвётся связь. Если голос работает — трогать не нужно." FontSize="13.5" Foreground="#9CA3AF" Margin="0,3,12,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="BtnUdpOpt" Grid.Column="1" Content="Подобрать" Style="{StaticResource SecondaryBtn}" MinWidth="106" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtUdpCurrent" Grid.Column="0" Text="Сейчас: quic_initial_www_google_com.bin" FontSize="12.5" Foreground="#737A86" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkUdpManual" Grid.Column="1" Content="Выбрать вручную" Style="{StaticResource DarkCheckBox}" Foreground="#9CA3AF" FontSize="13" VerticalAlignment="Center"/>
                                </Grid>
                                <ComboBox x:Name="CmbUdpFake" Grid.Row="2" Style="{StaticResource DarkCombo}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- VIEW 2: STRATEGIES -->
            <Grid x:Name="ViewStrats" Grid.Row="0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Стратегии обхода" FontSize="22" FontWeight="SemiBold" Foreground="#F1F3F5" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0E0F12" BorderBrush="#262930" BorderThickness="1" CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnTabCore" Content="Базовые (10)" Style="{StaticResource SegActive}" Margin="0,0,2,0"/>
                                <Button x:Name="BtnTabArch" Content="Дополнительные (12)" Style="{StaticResource SegInactive}"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnAddStrat" Content="+ Добавить .bat" Style="{StaticResource SecondaryBtn}" Padding="11,7" Margin="10,0,0,0" ToolTip="Добавить свой .bat конфиг в список стратегий"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Compact active hybrid recipe banner (shown when last_hybrid.json exists) -->
                    <Border x:Name="BdHybridRecipe" Grid.Row="0" Visibility="Collapsed" Background="#161A20" BorderBrush="{{ACCENT_BORDER_HX}}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{{ACCENT_SOFT_HEX}}" BorderBrush="{{ACCENT_BORDER_HX}}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                <TextBlock Text="Гибрид" FontSize="11.5" FontWeight="SemiBold" Foreground="{{ACCENT_LIGHT_HEX}}"/>
                            </Border>
                            <TextBlock x:Name="TxtHybridRecipe" Grid.Column="1" Text="" FontSize="12.5" Foreground="#D4D7DD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtHybridScore" Grid.Column="2" Text="" FontSize="12.5" FontWeight="SemiBold" Foreground="{{ACCENT_LIGHT_HEX}}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#1A1C21" BorderBrush="#262930" BorderThickness="1" CornerRadius="8" Padding="6">
                        <ListBox x:Name="ListStrategies"
                                 Background="Transparent" Foreground="#F1F3F5"
                                 BorderThickness="0" FontSize="15"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3" ToolTip="{Binding ScoreTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14.5" FontWeight="SemiBold" Foreground="#F1F3F5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Visibility="{Binding ActiveVis}" Background="{{ACCENT_SOFT_HEX}}" BorderBrush="{{ACCENT_BORDER_HX}}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="● Активна" FontSize="11" FontWeight="SemiBold" Foreground="{{ACCENT_LIGHT_HEX}}"/>
                                                </Border>
                                                <Border Visibility="{Binding TagVis}" Background="#23262E" BorderBrush="#343844" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TechTag}" FontSize="11" Foreground="#A1A8B5"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DescText}" FontSize="12" Foreground="#8B92A0" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Border Visibility="{Binding BreakdownVis}" Background="#14161B" BorderBrush="#282C34" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BreakdownText}" Foreground="#9CA3AF" FontSize="11.5"/>
                                            </Border>
                                            <Border Visibility="{Binding FreezeVis}" Background="{Binding FreezeBg}" BorderBrush="{Binding FreezeBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FreezeText}" Foreground="{Binding FreezeFg}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="68">
                                            <TextBlock Text="{Binding ScoreMain}" Foreground="{Binding ScoreBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding PingText}" Visibility="{Binding PingVis}" Foreground="#737A86" FontSize="11.5" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Не подходит ни одна?" Foreground="#737A86" FontSize="13" VerticalAlignment="Center" Margin="2,0,10,0"/>
                        <Button x:Name="BtnSynthStrat" Content="Собрать гибрид" Style="{StaticResource SecondaryBtn}" Padding="12,7" ToolTip="Прогнать все 22 стратегии и склеить персональный гибрид (YouTube + Discord + Web)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnProbeStrat" Content="Проверить выбранную" Style="{StaticResource SecondaryBtn}" Padding="12,7" Margin="0,0,8,0" ToolTip="Быстрый тест только выбранной в списке стратегии"/>
                        <Button x:Name="BtnApplyStrat" Content="Установить" Style="{StaticResource PrimaryBtn}" Padding="16,7"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- VIEW 3: SETTINGS & TOOLS -->
            <ScrollViewer x:Name="ViewSettings" Grid.Row="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Настройки и инструменты" FontSize="22" FontWeight="SemiBold" Foreground="#F1F3F5" Margin="0,0,0,16"/>

                    <TextBlock Text="Параметры обхода (применяются сразу)" FontSize="14" FontWeight="SemiBold" Foreground="#737A86" Margin="4,0,0,8"/>

                    <Border Style="{StaticResource GroupPanel}">
                        <StackPanel>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Авто-поиск заблокированных сайтов" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5" VerticalAlignment="Center"/><Border Background="{{ACCENT_SOFT_HEX}}" BorderBrush="{{ACCENT_BORDER_HX}}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Рекомендуется" FontSize="12.5" FontWeight="SemiBold" Foreground="{{ACCENT_LIGHT_HEX}}"/></Border><Border Width="16" Height="16" CornerRadius="8" Background="#202228" BorderBrush="#2E323B" BorderThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTipService.InitialShowDelay="120" ToolTip="Если сайт не открывается или сбрасывает соединение, winws2 сам добавляет его в lists\list-auto.txt и применяет обход. Посмотреть или очистить найденные домены можно в «Свои списки → Авто-найденные»."><TextBlock Text="i" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border></StackPanel>
                                    <TextBlock Text="Автоматически добавляет недоступные домены в --hostlist-auto" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkAutoHost" Grid.Column="1" Style="{StaticResource ToggleSwitch}" ToolTipService.InitialShowDelay="150" ToolTip="Если сайт не открывается или сбрасывает соединение, winws2 сам добавляет его в lists\list-auto.txt и применяет обход. Посмотреть или очистить найденные домены можно в «Свои списки → Авто-найденные»."/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Разблокировка Cloudflare WARP" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5" VerticalAlignment="Center"/><Border Background="{{ACCENT_SOFT_HEX}}" BorderBrush="{{ACCENT_BORDER_HX}}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Рекомендуется" FontSize="12.5" FontWeight="SemiBold" Foreground="{{ACCENT_LIGHT_HEX}}"/></Border><Border Width="16" Height="16" CornerRadius="8" Background="#202228" BorderBrush="#2E323B" BorderThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTipService.InitialShowDelay="120" ToolTip="Включает обход на UDP-портах 500, 1701, 2408 и 4500, чтобы приложение Cloudflare WARP (1.1.1.1) подключалось без вечной загрузки. Обычному интернету не мешает."><TextBlock Text="i" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border></StackPanel>
                                    <TextBlock Text="Поддерживает обход для подключения к серверам WARP" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkWarp" Grid.Column="1" Style="{StaticResource ToggleSwitch}" ToolTipService.InitialShowDelay="150" ToolTip="Включает обход на UDP-портах 500, 1701, 2408 и 4500, чтобы приложение Cloudflare WARP (1.1.1.1) подключалось без вечной загрузки. Обычному интернету не мешает."/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Игровой фильтр (GameFilter)" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5" VerticalAlignment="Center"/><Border Background="#202926" BorderBrush="#2E323B" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Опционально" FontSize="12.5" FontWeight="SemiBold" Foreground="#9CA3AF"/></Border><Border Width="16" Height="16" CornerRadius="8" Background="#202228" BorderBrush="#2E323B" BorderThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTipService.InitialShowDelay="120" ToolTip="Расширяет обход на диапазон портов 1024–65535 (по ipset-all.txt). Включай только если не подключаются онлайн-игры (Valorant, Roblox, Apex и др.) — на торрентах и P2P может давать лишнюю нагрузку."><TextBlock Text="i" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border></StackPanel>
                                    <TextBlock Text="Расширяет обход на порты онлайн-игр (1024–65535)" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkGameFilter" Grid.Column="1" Style="{StaticResource ToggleSwitch}" ToolTipService.InitialShowDelay="150" ToolTip="Расширяет обход на диапазон портов 1024–65535 (по ipset-all.txt). Включай только если не подключаются онлайн-игры (Valorant, Roblox, Apex и др.) — на торрентах и P2P может давать лишнюю нагрузку."/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Исключение VPN (WinDivert)" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5" VerticalAlignment="Center"/><Border Width="16" Height="16" CornerRadius="8" Background="#202228" BorderBrush="#2E323B" BorderThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTipService.InitialShowDelay="120" ToolTip="Ограничивает работу winws2.exe физическими картами (Ethernet / Wi-Fi / PPPoE) через --wf-raw-filter. Все VPN (WARP, Happ, WireGuard, Amnezia, Radmin) полностью исключаются на уровне пакетов — основной интернет работает 24/7 без пауз."><TextBlock Text="i" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border></StackPanel>
                                    <TextBlock x:Name="TxtNlmStatus" Text="Обход работает на физ. картах (Ethernet / Wi-Fi / PPPoE) — все VPN исключаются без пауз" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnNlmConfig" Content="Настроить" Style="{StaticResource SecondaryBtn}" Padding="10,5" FontSize="13.5" Margin="0,0,10,0" ToolTip="Выбрать интерфейсы обхода вручную (например, добавить ExitLag)"/>
                                    <CheckBox x:Name="ChkNlmVpn" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" ToolTipService.InitialShowDelay="150" ToolTip="Исключает все VPN-адаптеры на уровне WinDivert (--wf-raw-filter), оставляя обход активным на Ethernet / Wi-Fi / PPPoE 24/7."/>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Фильтрация UDP на уровне ядра (WinDivert)" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5" VerticalAlignment="Center"/><Border Background="{{ACCENT_SOFT_HEX}}" BorderBrush="{{ACCENT_BORDER_HX}}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="Рекомендуется" FontSize="12.5" FontWeight="SemiBold" Foreground="{{ACCENT_LIGHT_HEX}}"/></Border><Border Width="16" Height="16" CornerRadius="8" Background="#202228" BorderBrush="#2E323B" BorderThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTipService.InitialShowDelay="120" ToolTip="Использует официальные фильтры windivert_part из zapret2 v1.0.7: лишние UDP-пакеты отсекаются прямо в драйвере, не нагружая процессор. Делает пинг в играх и голосе Discord стабильнее."><TextBlock Text="i" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border></StackPanel>
                                    <TextBlock Text="Отсекает лишние UDP-пакеты в драйвере — меньше нагрузка на CPU и стабильнее пинг в играх и Discord" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkKernelFilter" Grid.Column="1" Style="{StaticResource ToggleSwitch}" ToolTipService.InitialShowDelay="150" ToolTip="Использует официальные фильтры windivert_part из zapret2 v1.0.7: лишние UDP-пакеты отсекаются прямо в драйвере, не нагружая процессор. Делает пинг в играх и голосе Discord стабильнее."/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="Сворачивать в трей при закрытии" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5" VerticalAlignment="Center"/><Border Width="16" Height="16" CornerRadius="8" Background="#202228" BorderBrush="#2E323B" BorderThickness="1" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Help" ToolTipService.InitialShowDelay="120" ToolTip="Если выключено (по умолчанию) — при нажатии на крестик окно закрывается полностью, а обход продолжает тихо работать фоновой службой. Если включено — иконка Котека остаётся возле часов для быстрого доступа."><TextBlock Text="i" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/></Border></StackPanel>
                                    <TextBlock Text="Показывает иконку Котека возле часов и тихо запускает её в трее после перезагрузки ПК (без UAC)" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkTrayMode" Grid.Column="1" Style="{StaticResource ToggleSwitch}" ToolTipService.InitialShowDelay="150" ToolTip="Если выключено (по умолчанию) — при нажатии на крестик окно закрывается полностью, а обход продолжает тихо работать фоновой службой. Если включено — иконка Котека остаётся возле часов для быстрого доступа."/>
                            </Grid>
                            <Grid Margin="16,4,16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Запускать сразу свёрнутым в трей" FontSize="14.5" FontWeight="Medium" Foreground="#F1F3F5"/>
                                    <TextBlock Text="При запуске Котека окно не открывается — сразу появляется иконка возле часов" FontSize="13" Foreground="#9CA3AF" Margin="0,2,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkTrayStartMin" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=ChkTrayMode}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Инструменты" FontSize="14" FontWeight="SemiBold" Foreground="#737A86" Margin="4,0,0,8"/>

                    <Border Style="{StaticResource GroupPanel}">
                        <StackPanel>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Диагностика подключения" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5"/>
                                    <TextBlock Text="Соберёт отчёт о службах и скопирует его в буфер обмена" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0"/>
                                </StackPanel>
                                <Button x:Name="BtnDiag" Grid.Column="1" Content="Проверить" Style="{StaticResource SecondaryBtn}" MinWidth="106" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Папка программы" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5"/>
                                    <TextBlock x:Name="TxtFolder" Text="—" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnCreateShortcut" Content="Создать ярлык" Style="{StaticResource SecondaryBtn}" Padding="11,7" Margin="0,0,6,0" ToolTipService.InitialShowDelay="150" ToolTip="Создать ярлык Zapret2 Kotek на Рабочем столе и в меню Пуск"/>
                                    <Button x:Name="BtnOpenDir" Content="Открыть" Style="{StaticResource SecondaryBtn}" Padding="11,7"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Свои списки сайтов и исключений" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5"/>
                                    <TextBlock Text="Добавить сайты в обход или в исключения в 1 клик (с очисткой ссылок)" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnEditGenUser" Content="Свои сайты" Style="{StaticResource SecondaryBtn}" Padding="11,7" Margin="0,0,6,0" ToolTipService.InitialShowDelay="150" ToolTip="Открыть редактор списка сайтов для обхода (list-general-user.txt)"/>
                                    <Button x:Name="BtnEditExUser" Content="Исключения" Style="{StaticResource SecondaryBtn}" Padding="11,7"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Обновления" FontSize="14" FontWeight="SemiBold" Foreground="#737A86" Margin="4,0,0,8"/>

                    <Border Style="{StaticResource GroupPanel}">
                        <StackPanel>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Режим фильтра IPSet" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5"/>
                                    <TextBlock Text="loaded — список IP, none — только домены + авто-хостлист, any — весь трафик" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbIpsetMode" Grid.Column="1" Style="{StaticResource DarkCombo}" Width="192" FontSize="14" VerticalAlignment="Center" ToolTipService.InitialShowDelay="150" ToolTip="loaded — стандартная база подсетей&#10;none — обход только по доменам (экономит ресурсы с Авто-хостлистом)&#10;any — применять ко всем IP"/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Списки сайтов и IP (IPSet + Hosts)" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5"/>
                                    <TextBlock Text="Загрузит свежую базу подсетей и доменов, перезапустит службу" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0"/>
                                </StackPanel>
                                <Button x:Name="BtnUpdateLists" Grid.Column="1" Content="Обновить" Style="{StaticResource SecondaryBtn}" MinWidth="106" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Обновления Zapret2 Kotek (GitHub)" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5"/>
                                    <TextBlock x:Name="TxtUpdateInfo" Text="Текущая версия: v{{VERSION}}" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="BtnCheckUpdate" Grid.Column="1" Content="Проверить" Style="{StaticResource SecondaryBtn}" MinWidth="106" VerticalAlignment="Center"/>
                            </Grid>
                            <Border Style="{StaticResource RowDivider}"/>
                            <Grid Margin="16,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Автообновление (релизы и списки)" FontSize="15.5" FontWeight="Medium" Foreground="#F1F3F5"/>
                                    <TextBlock x:Name="TxtAutoUpdDesc" Text="Тихо обновляет Zapret2 Kotek без нагрузки в фоне" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="CmbAutoUpdMode" Style="{StaticResource DarkCombo}" Width="186" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" ToolTipService.InitialShowDelay="150" ToolTip="1 раз в неделю — по воскресеньям в простое ПК&#10;2 раза в неделю — по средам и воскресеньям в простое&#10;1 раз в месяц — раз в 30 дней в простое&#10;При включении ПК — через 30 секунд после старта Windows"/>
                                    <CheckBox x:Name="ChkAutoUpdate" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Поддержка проекта ♡" FontSize="14" FontWeight="SemiBold" Foreground="#E88CA5" Margin="4,0,0,8"/>

                    <Border Style="{StaticResource GroupPanel}" Background="#1E171B" BorderBrush="#4D2F3D">
                        <Grid Margin="16,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Помочь разработке (анонимные отчёты)" FontSize="15.5" FontWeight="Medium" Foreground="#FCE7EF" VerticalAlignment="Center"/>
                                    <Border Background="#2D1D25" BorderBrush="#6E3F54" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="По желанию" FontSize="12.5" FontWeight="SemiBold" Foreground="#F2A7BE"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Отправляет версию, стратегию, тех-срез и логи при сбоях (без путей, IP и списков сайтов)" FontSize="14" Foreground="#C8AAB6" Margin="0,2,12,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnTelemetryPreview" Content="Что уходит?" Style="{StaticResource SecondaryBtn}" Background="#291D23" BorderBrush="#5C3647" Foreground="#F5D0DE" Padding="10,5" FontSize="13" Margin="0,0,10,0" ToolTip="Посмотреть точный пример JSON-отчёта"/>
                                <CheckBox x:Name="ChkTelemetry" Style="{StaticResource PinkToggleSwitch}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="Удаление" FontSize="14" FontWeight="SemiBold" Foreground="#737A86" Margin="4,0,0,8"/>

                    <Border Style="{StaticResource GroupPanel}" Margin="0">
                        <Grid Margin="16,13">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Удалить Zapret2 Kotek из системы" FontSize="15.5" FontWeight="Medium" Foreground="#FCA5A5"/>
                                <TextBlock Text="Остановит и удалит службы обхода, прокси и драйвер WinDivert" FontSize="14" Foreground="#9CA3AF" Margin="0,2,12,0"/>
                            </StackPanel>
                            <Button x:Name="BtnUninstall" Grid.Column="1" Content="Удалить" Style="{StaticResource DangerBtn}" MinWidth="106" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Status Strip + Silent Progress + Completion Toast -->
            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                <Border x:Name="ToastBanner" Visibility="Collapsed" Background="#162822" BorderBrush="{{ACCENT_BORDER_HX}}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtToastMsg" Grid.Column="0" Text="" FontSize="14.5" FontWeight="SemiBold" Foreground="#F1F3F5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button x:Name="BtnCloseToast" Grid.Column="1" Content="✕" Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" FontSize="14" Padding="6,0,0,0" Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border x:Name="StatusRow" BorderBrush="#202228" BorderThickness="0,1,0,0" Padding="2,8,2,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtStatusBar" Grid.Column="0" Text="Готово к работе." FontSize="14" Foreground="#737A86" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="BarProgress" Grid.Column="1" Width="118" Height="6" IsIndeterminate="True" Visibility="Collapsed" Margin="12,0,0,0" Background="#1F242D" Foreground="{StaticResource AccentBrush}" BorderThickness="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
